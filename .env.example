# 生成后替换：openssl rand -hex 32；密钥须长期保留，用于解密托管的 SSH 私钥。
CLINAVAT_MASTER_KEY=replace_with_64_hex_characters
CLINAVAT_DATA_DIR=../data
CLINAVAT_WORKSPACE_DIR=/var/tmp/clinavat-workspace
CLINAVAT_HOST=127.0.0.1
CLINAVAT_PORT=3001
# 仅首次启动时导入的访问白名单；之后在管理面板 → 网关和访问 → 访问配置保存 Public URL。
# 可留空，默认允许 localhost / 127.0.0.1 + 后端、Web 服务端口；开发环境还允许 VITE_PORT。
# 多个完整 HTTP(S) 地址用逗号或空白分隔，不支持路径、参数、片段或通配符。
# 如需首次直接通过公开域名访问，可填 https://clinavat.example.com,https://clinavat.example.net。
CLINAVAT_ORIGIN=
CLINAVAT_COOKIE_SECURE=false
CLINAVAT_REGISTRATION=false
CLINAVAT_APPROVAL_TIMEOUT_MS=300000
CLINAVAT_CLAUDE_BIN=claude
CLINAVAT_CODEX_BIN=codex
CLINAVAT_MUTAGEN_BIN=mutagen
CLINAVAT_SSH_BIN=ssh
CLINAVAT_SSH_KEYGEN_BIN=ssh-keygen
# 网关控制面（deploy/gateway）；留空则管理面板不连接网关。
CLINAVAT_GATEWAY_HOST=
CLINAVAT_GATEWAY_PORT=22
CLINAVAT_GATEWAY_USER=root
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_PORT=5173

# 宿主 / Compose 共用的 Web 入口
CLINAVAT_WEB_PORT=8080
# 首次初始化后，按部署需要改为号池机内部网卡地址或 0.0.0.0。
CLINAVAT_WEB_BIND=127.0.0.1
# PUBLIC_ORIGIN 仅供 Compose 首次导入名单使用，之后修改环境变量不会覆盖面板配置。
# 自定义 Web 入口端口需同时传给 Hub，以生成正确的本地默认来源。
CLINAVAT_PUBLIC_ORIGIN=
# 生产环境请在入口终止 TLS 并将 CLINAVAT_COOKIE_SECURE 设为 true。
CLAUDE_CODE_VERSION=2.1.308
CODEX_VERSION=0.164.0
MUTAGEN_VERSION=0.18.1

# Compose 部署显式指定卷名。
CLINAVAT_DATA_VOLUME=clinavat-data
CLINAVAT_WORKSPACE_VOLUME=clinavat-workspaces
