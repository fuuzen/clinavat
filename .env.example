# 生成后替换：openssl rand -hex 32；密钥须长期保留，用于解密托管的 SSH 私钥。
CC_POOL_MASTER_KEY=replace_with_64_hex_characters
CC_POOL_DATA_DIR=../data
CC_POOL_HOST=127.0.0.1
CC_POOL_PORT=3001
# 必须与浏览器访问地址完全一致；宿主部署改为 http://localhost:8080，Compose 使用下方 PUBLIC_ORIGIN。
CC_POOL_ORIGIN=http://localhost:5173
CC_POOL_COOKIE_SECURE=false
CC_POOL_REGISTRATION=false
CC_POOL_APPROVAL_TIMEOUT_MS=300000
CC_POOL_CLAUDE_BIN=claude
CC_POOL_CODEX_BIN=codex
CC_POOL_MUTAGEN_BIN=mutagen
CC_POOL_SSH_BIN=ssh
CC_POOL_SSH_KEYGEN_BIN=ssh-keygen
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_PORT=5173

# 宿主 / Compose 共用的 Web 入口
CC_POOL_WEB_PORT=8080
# 首次初始化后，按部署需要改为号池机内部网卡地址或 0.0.0.0。
CC_POOL_WEB_BIND=127.0.0.1
# 以下 PUBLIC_ORIGIN 和 CLI 版本参数供 Compose 使用；宿主后端读取上方 CC_POOL_ORIGIN。
CC_POOL_PUBLIC_ORIGIN=http://localhost:8080
# 生产环境请在入口终止 TLS 并将 CC_POOL_COOKIE_SECURE 设为 true。
CLAUDE_CODE_VERSION=2.1.308
CODEX_VERSION=0.164.0
MUTAGEN_VERSION=0.18.1
